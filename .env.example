# Copie para .env e preencha. NUNCA commite o .env.
DATABASE_URL=mysql://adspilot:SENHA@localhost:3306/adspilot_dev
APP_URL=http://localhost:3000
# Em desenvolvimento, e-mails (recuperação de senha) vão para a tabela email_outbox e para o log.
# Envio real de e-mail (SMTP) ainda NÃO está implementado.
# Chave AES-256 (32 bytes em base64) para criptografar tokens da Meta. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Integração real com a Meta (OAuth). Sem estes valores só o modo demonstração está disponível.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Segredo (≥ 24 caracteres) das rotas de cron (POST /api/cron/sync, header x-cron-secret). Vazio = rotas desativadas.
CRON_SECRET=
# WhatsApp via Evolution API (alertas críticos). Sem estes valores as mensagens ficam "bloqueadas" na fila e nada é enviado.
# A URL precisa ser https (http só para localhost).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
