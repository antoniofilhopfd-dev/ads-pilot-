{
  "name": "adspilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "sync": "tsx --env-file=.env scripts/sync-all.ts",
    "backup": "bash scripts/backup.sh",
    "test:backup": "bash scripts/backup-restore-test.sh",
    "bench": "tsx --env-file=.env scripts/bench.ts",
    "e2e": "for s in e2e e2e-conta e2e-meta e2e-ops e2e-reports e2e-mcp e2e-security e2e-acesso e2e-logo e2e-fundacao e2e-gestao; do tsx --env-file=.env scripts/$s.ts || exit 1; done",
    "a11y": "tsx scripts/a11y.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.5",
    "next": "^16.4.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
